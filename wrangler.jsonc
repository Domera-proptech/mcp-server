{
  "name": "domera-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "OPENAI_APPS_CHALLENGE": "M0ZrnXTinyq6u6AutkttoiCdZiOx4e1wAYDDp523PwY" },
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "routes": [{ "pattern": "mcp.domera.se", "custom_domain": true }]
}
